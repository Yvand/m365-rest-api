meta {
  name: Search basic 2 copy
  type: http
  seq: 7
}

post {
  url: https://graph.microsoft.com/beta/search/query
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "requests": [
      {
        "entityTypes": [
          "driveItem"
        ],
        "query": {
          "queryString": "extension:pdf",
          "queryTemplate": "{searchTerms} path:\"https://spsites.yvand.net/\""
        },
        "fields": [
          "DocId",
          "SiteID",
          "WebID",
          "ListID",
          "UniqueID",
          "Path",
          "DocumentLink",
          "WebUrl",
          "FIleID"
        ],
        "from": 0,
        "size": 25
      }
    ]
  }
}
