meta {
  name: show external group
  type: http
  seq: 1
}

get {
  url: https://graph.microsoft.com/v1.0/external/connections/{{connectionId}}/groups/{{externalGroupId}}
  body: none
  auth: inherit
}

vars:pre-request {
  connectionId: AzureDevOps2511191104
}

settings {
  encodeUrl: true
  timeout: 0
}
