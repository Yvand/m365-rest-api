meta {
  name: List drives in a site
  type: http
  seq: 2
}

get {
  url: https://graph.microsoft.com/v1.0/sites/{{tenantPrefix}}.sharepoint.com:{{siteRelativePath}}:/drives?$select=name, id, webUrl
  body: none
  auth: none
}

params:query {
  $select: name, id, webUrl
  ~whatif: null
}

headers {
  Content-Type: application/json
}
