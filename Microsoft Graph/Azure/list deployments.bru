meta {
  name: list deployments
  type: http
  seq: 1
}

get {
  url: https://management.azure.com/subscriptions/{{subscriptionId}}/providers/Microsoft.Resources/deployments/?api-version=2021-04-01
  body: none
  auth: none
}

params:query {
  api-version: 2021-04-01
  ~$select: id, name, type, location
}

docs {
  To get the access token:
  
  ```powershell
  Get-AzAccessToken -ResourceUrl "https://management.azure.com/"
  ```
  
}
