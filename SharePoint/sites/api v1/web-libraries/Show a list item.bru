meta {
  name: Show a list item
  type: http
  seq: 2
}

get {
  url: https://{{tenantPrefix}}.sharepoint.com{{siteRelativePath}}/_api/web/lists/GetByTitle('{{docLibTitle}}')/items(1)
  body: none
  auth: inherit
}

params:query {
  ~$select: Id, Title
}

headers {
  Accept: application/json;odata=verbose
  ContentType: application/json;odata=verbose
}

vars:pre-request {
  docLibTitle: Documents
}
