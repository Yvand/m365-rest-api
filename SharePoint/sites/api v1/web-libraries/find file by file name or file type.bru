meta {
  name: find file by file name or file type
  type: http
  seq: 10
}

get {
  url: https://{{tenantPrefix}}.sharepoint.com{{siteRelativePath}}/_api/web/lists/GetByTitle('{{docLibTitle}}')/items?$select=Id, Title, ServerRedirectedEmbedUri, FileLeafRef, AuthorId, EditorId&$filter=FileLeafRef eq 'Lorem ipsum.pdf'
  body: none
  auth: inherit
}

params:query {
  $select: Id, Title, ServerRedirectedEmbedUri, FileLeafRef, AuthorId, EditorId
  $filter: FileLeafRef eq 'Lorem ipsum.pdf'
  ~$filter: File_x0020_Type eq 'pdf'
}

headers {
  Accept: application/json;odata=verbose
  ContentType: application/json;odata=verbose
}

vars:pre-request {
  docLibTitle: Documents
}
