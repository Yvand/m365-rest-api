meta {
  name: show current user groups
  type: http
  seq: 24
}

get {
  url: https://{{tenantPrefix}}.sharepoint.com{{siteRelativePath}}/_api/web/CurrentUser/Groups
  body: none
  auth: inherit
}

params:query {
  ~$select: LoginName
}

headers {
  Accept: application/json;odata=verbose
  ContentType: application/json;odata=verbose
}
