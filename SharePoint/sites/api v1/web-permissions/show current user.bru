meta {
  name: show current user
  type: http
  seq: 2
}

get {
  url: https://{{tenantPrefix}}.sharepoint.com{{siteRelativePath}}/_api/web/CurrentUser?$expand=UserId
  body: none
  auth: inherit
}

params:query {
  $expand: UserId
  ~$select: LoginName
}

headers {
  Accept: application/json;odata=verbose
  ContentType: application/json;odata=verbose
}
