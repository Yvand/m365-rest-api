meta {
  name: find file by file name or file type
  type: http
  seq: 3
}

get {
  url: https://{{tenantPrefix}}-my.sharepoint.com/personal/admin_{{tenantPrefix}}_onmicrosoft_com/_api/web/lists/GetByTitle('Documents')/items?$select=Id, Title, ServerRedirectedEmbedUri, FileLeafRef, AuthorId, EditorId&$filter=FileLeafRef eq 'Lorem ipsum.pdf'
  body: none
  auth: inherit
}

params:query {
  $select: Id, Title, ServerRedirectedEmbedUri, FileLeafRef, AuthorId, EditorId
  $filter: FileLeafRef eq 'Lorem ipsum.pdf'
}

headers {
  Content-Type: application/json
  Accept: application/json
}
