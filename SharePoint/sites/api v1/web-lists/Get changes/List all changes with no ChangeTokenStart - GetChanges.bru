meta {
  name: List all changes with no ChangeTokenStart - GetChanges
  type: http
  seq: 2
}

post {
  url: https://{{tenantPrefix}}.sharepoint.com{{siteRelativePath}}/_api/web/lists/GetByTitle('rerlist')/RootFolder/GetChanges?$expand=RelativeTime&$orderby=Time desc&$top=2
  body: json
  auth: inherit
}

params:query {
  $expand: RelativeTime
  $orderby: Time desc
  $top: 2
}

headers {
