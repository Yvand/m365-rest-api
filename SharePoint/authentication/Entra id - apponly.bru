meta {
  name: Entra id - apponly
  type: http
  seq: 1
}

get {
  url: 
  body: none
  auth: oauth2
}

auth:oauth2 {
  grant_type: client_credentials
  access_token_url: https://login.microsoftonline.com/{{tenantPrefix}}.onmicrosoft.com/oauth2/v2.0/token
  refresh_token_url: 
  client_id: {{clientId}}
  client_secret: {{clientSecret}}
  scope: https://{{tenantPrefix}}.sharepoint.com/.default
  credentials_placement: body
  credentials_id: credentials
  token_placement: header
  token_header_prefix: 
  auto_fetch_token: true
  auto_refresh_token: false
}

vars:post-response {
  accessToken: res.body.access_token
}

script:post-response {
  bru.setEnvVar("accessToken", res.body.access_token);
  bru.setGlobalEnvVar("accessToken", res.body.access_token);
  console.log("yoyo")
}
