meta {
  name: list backlogs
  type: http
  seq: 1
}

get {
  url: https://dev.azure.com/{{adoOrgName}}/{{projectName}}/{{team}}/_apis/work/backlogs?api-version=7.1
  body: none
  auth: inherit
}

params:query {
  api-version: 7.1
}

vars:pre-request {
  team: EntraCP Team
}

settings {
  encodeUrl: true
  timeout: 0
}
