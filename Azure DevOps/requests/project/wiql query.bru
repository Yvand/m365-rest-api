meta {
  name: wiql query
  type: http
  seq: 7
}

post {
  url: https://dev.azure.com/{{adoOrgName}}/{{projectName}}/_apis/wit/wiql?$top=100&api-version=7.1
  body: json
  auth: inherit
}

params:query {
  $top: 100
  api-version: 7.1
}

body:json {
  {
    "query": "Select [System.Id], [System.Title], [System.State] From WorkItems Where [System.WorkItemType] = 'Task' AND [State] <> 'Closed' AND [State] <> 'Removed' order by [Microsoft.VSTS.Common.Priority] asc, [System.CreatedDate] desc"
  }
}

vars:pre-request {
  team: EntraCP Team
}

settings {
  encodeUrl: true
  timeout: 0
}
